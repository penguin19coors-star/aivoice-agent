# ─── RUNTIME ENV ──────────────────────────────────────────────────────────────
# Fill these in. Never commit secrets to git.

# Twilio
# Twilio phoneline
TWILIO_ACCOUNT_SID= # no longer needed for inbound call webhooks
TWILIO_AUTH_TOKEN= # no longer needed for inbound call webhooks
PUBLIC_WSS_URL=wss://aivoice-agent.onrender.com/ws
PUBLIC_WS_URL=wss://aivoice-agent.onrender.com/ws
PUBLIC_BASE_URL=https://aivoice-agent.onrender.com

# Browser automation credentials (only for browser-use agents)
EMAIL= # e.g you@gmail.com
PASSWORD= # your email or service login password

# STT — Deepgram (free tier: 200 min/month, key at deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_key

# LLM — Choose ONE provider:
#  Option A: Together AI (cheap & fast, ~$0.30/1M input tokens)
LLM_PROVIDER=together
LLM_API_KEY=your_together_key
LLM_BASE_URL=https://api.together.xyz/v1
LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo

#  Option B: OpenRouter (access 300+ models via one key)
# LLM_PROVIDER=openrouter
# LLM_API_KEY=your_openrouter_key
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free

# TTS — Choose ONE:
#  Option A: ElevenLabs (best quality, ~$0.09/min)
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE=21m00Tcm4TlvDq8ikWAM   # Rachel (default)

#  Option B: Deepgram Aura (free tier available)
# TTS_PROVIDER=deepgram

#  Option C: OpenAI (clear, ~$0.015/1K chars)
# TTS_PROVIDER=openai
# OPENAI_API_KEY=your_openai_key
# OPENAI_TTS_VOICE=nova

# Cost optimisation
TWILIO_RATE_PER_MIN=0.013
AVG_CALL_DURATION_MIN=5
ADS_PER_CALL=1

# ── NEW FOR THIS VERSION ──────────────────────────────────────────────────────
NEWS_API_KEY=                         # NewsAPI.org free tier key (100 req/day)
BILLING_WEBHOOK_ENABLED=0            # 1 to enable outbound impression webhooks
BILLING_WEBHOOK_URL=                 # POST JSON {event:"ad_impression", data:{...}}
BILLING_WEBHOOK_SECRET=              # HMAC-SHA256 signing secret (optional)

# Web lookup — Serper.dev (Google results for ACCURATE phone/address/hours/weather)
# 2,500 free queries, then ~$0.30 per 1,000. Key at serper.dev
# Only called when the caller asks a factual lookup question, so it's cheap.
SERPER_API_KEY=

# Admin dashboard — set a long random string; required to open /admin
# Generate one: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Persistence — SQLite. On Render, attach a persistent disk (e.g. mount /var/data)
# and set this to a path on that disk so play counts/revenue survive restarts.
# Locally it defaults to ./data/aivoice.db. Leave blank to use the default.
DATABASE_PATH=/var/data/aivoice.db

